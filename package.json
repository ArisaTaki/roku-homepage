{
  "name": "roku-homepage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync:tsukuyomi": "node tools/sync-tsukuyomi.mjs",
    "sync:projects": "node tools/sync-project-releases.mjs",
    "check:project-releases": "node tools/sync-project-releases.mjs --check",
    "package:game-release": "node tools/package-game-release.mjs",
    "check:tsukuyomi-deployment": "node tools/check-tsukuyomi-deployment.mjs",
    "test:tsukuyomi": "node --test tools/sync-tsukuyomi.test.mjs tools/check-tsukuyomi-deployment.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && npm run build:api",
    "build:api": "esbuild server/iroha-server.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist-api/iroha-server.mjs",
    "preview": "vite preview",
    "smoke:iroha": "tsx tools/smoke-iroha-assistant.ts",
    "check:iroha": "npm run smoke:iroha && tsx tools/check-iroha-manifest.ts"
  },
  "dependencies": {
    "@remotion/player": "^4.0.481",
    "lenis": "^1.3.26",
    "lucide-react": "^0.475.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.481"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.27.7",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
